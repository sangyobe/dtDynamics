################################################################################
# Polyspace Bug Finder 옵션 파일 — dtdynamics
# 소스/결과 경로는 .gitlab-ci.yml 에서 명령행으로 전달
# 주의: 옵션과 같은 줄에 주석(#) 사용 불가 — 별도 줄에만 허용
################################################################################

# ── 코드 메트릭 ──────────────────────────────────────────────────────────────
# 순환 복잡도(Cyclomatic Complexity), 함수당 라인 수 등 코드 품질 지표 산출 (결함 검출과는 별개)
# -code-metrics

# ── 결과 범위  ───────────────────────────────────────────────────────────
# include/ 헤더도 결과에 포함.
-generate-results-for all-headers

# 시스템/표준 라이브러리 헤더(/usr/include, /usr/lib) 는 all-headers 범위에서 제외
# /root/.local/ART_Framework 는 의존 라이브러리(dtMath 등) 설치 경로 — dtdynamics 자체 소스가 아니므로 제외
# .ci/dtmath 는 CI가 고정 SHA로 job-local checkout 하는 dtMath 헤더 — dtdynamics 자체 소스가 아니므로 제외
-do-not-generate-results-for custom=/usr/include,/usr/lib,/root/.local/ART_Framework,.ci/dtmath

# 자동 생성 코드가 생기면 여기에 추가
# 예: -do-not-generate-results-for custom=proto
