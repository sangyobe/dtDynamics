digraph validation_refs {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fillcolor="#f8f8f8"];
  native [label="dtDynamics production\ndtMath-only public package"];
  native_bench [label="Native dynamics-only benchmarks\nCCRBA all | RNEA + CoM"];
  leo_bench [label="Optional LeoQuad scope\nreduced CCRBA + indexed Jacobians"];
  tests [label="validation executables\nprivate deps only"];
  mujoco [label="MuJoCo 3.8.0\nindexing/dynamics reference"];
  pin [label="Pinocchio 3.9.0\nindependent dynamics reference"];
  controller [label="LeoQuad/runtime gate\nconsumer validation"];
  native -> native_bench;
  native -> leo_bench;
  native -> tests;
  tests -> mujoco [style=dashed];
  tests -> pin [style=dashed];
  leo_bench -> controller;
}
