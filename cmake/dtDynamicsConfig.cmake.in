@PACKAGE_INIT@

set_and_check(DTDYNAMICS_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

if(DEFINED DTDYNAMICS_DTMATH_INCLUDE_DIR AND
   EXISTS "${DTDYNAMICS_DTMATH_INCLUDE_DIR}/dtMath/dtMath.h")
    set(_DTDYNAMICS_DTMATH_INCLUDE_DIR "${DTDYNAMICS_DTMATH_INCLUDE_DIR}")
elseif(EXISTS "${DTDYNAMICS_INCLUDE_DIR}/dtMath/dtMath.h")
    set(_DTDYNAMICS_DTMATH_INCLUDE_DIR "${DTDYNAMICS_INCLUDE_DIR}")
else()
    message(FATAL_ERROR
        "dtDynamics requires dtMath headers. Install dtMath into the same prefix "
        "as dtDynamics, or set DTDYNAMICS_DTMATH_INCLUDE_DIR before find_package(dtDynamics).")
endif()

if(TARGET dt::Dynamics)
    get_property(_DTDYNAMICS_CONFIG_TARGET_ORIGIN TARGET dt::Dynamics
        PROPERTY DTDYNAMICS_CONFIG_TARGET_ORIGIN)
    if(NOT "${_DTDYNAMICS_CONFIG_TARGET_ORIGIN}" STREQUAL "${CMAKE_CURRENT_LIST_FILE}")
        message(FATAL_ERROR
            "dtDynamics target collision: dt::Dynamics already exists before "
            "find_package(dtDynamics). Refusing to bind to an unverified target.")
    endif()
else()
    include("${CMAKE_CURRENT_LIST_DIR}/dtDynamicsTargets.cmake")
    if(NOT TARGET dt::Dynamics)
        message(FATAL_ERROR "dtDynamics export did not define dt::Dynamics.")
    endif()
    set_property(TARGET dt::Dynamics PROPERTY DTDYNAMICS_CONFIG_TARGET_ORIGIN
        "${CMAKE_CURRENT_LIST_FILE}")
endif()

if(TARGET dt::Dynamics)
    get_property(_DTDYNAMICS_INTERFACE_INCLUDES TARGET dt::Dynamics
        PROPERTY INTERFACE_INCLUDE_DIRECTORIES)
    list(FIND _DTDYNAMICS_INTERFACE_INCLUDES "${_DTDYNAMICS_DTMATH_INCLUDE_DIR}"
        _DTDYNAMICS_DTMATH_INCLUDE_INDEX)
    if(_DTDYNAMICS_DTMATH_INCLUDE_INDEX EQUAL -1)
        list(PREPEND _DTDYNAMICS_INTERFACE_INCLUDES
            "${_DTDYNAMICS_DTMATH_INCLUDE_DIR}")
        set_property(TARGET dt::Dynamics PROPERTY
            INTERFACE_INCLUDE_DIRECTORIES "${_DTDYNAMICS_INTERFACE_INCLUDES}")
    endif()
endif()

check_required_components(dtDynamics)
