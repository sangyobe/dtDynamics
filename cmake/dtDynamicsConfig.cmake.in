@PACKAGE_INIT@

set_and_check(DTDYNAMICS_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

if(DEFINED DTDYNAMICS_DTMATH_INCLUDE_DIR AND
   EXISTS "${DTDYNAMICS_DTMATH_INCLUDE_DIR}/dtMath/dtMath.h")
    set(_DTDYNAMICS_DTMATH_INCLUDE_DIR "${DTDYNAMICS_DTMATH_INCLUDE_DIR}")
elseif(EXISTS "${DTDYNAMICS_INCLUDE_DIR}/dtMath/dtMath.h")
    set(_DTDYNAMICS_DTMATH_INCLUDE_DIR "${DTDYNAMICS_INCLUDE_DIR}")
else()
    message(FATAL_ERROR
        "dtDynamics requires dtMath headers. Install dtMath into the same prefix "
        "as dtDynamics, or set DTDYNAMICS_DTMATH_INCLUDE_DIR before find_package(dtDynamics).")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/dtDynamicsTargets.cmake")

if(TARGET dt::Dynamics)
    set_property(TARGET dt::Dynamics APPEND PROPERTY
        INTERFACE_INCLUDE_DIRECTORIES "${_DTDYNAMICS_DTMATH_INCLUDE_DIR}")
endif()

check_required_components(dtDynamics)
